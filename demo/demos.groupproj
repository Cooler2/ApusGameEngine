            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="SimpleDemo">
        <MSBuild Projects="SimpleDemo\SimpleDemo.dproj"/>
    </Target>
    <Target Name="SimpleDemo:Clean">
        <MSBuild Projects="SimpleDemo\SimpleDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SimpleDemo:Make">
        <MSBuild Projects="SimpleDemo\SimpleDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="scenes">
        <MSBuild Projects="01-Scenes\scenes.dproj"/>
    </Target>
    <Target Name="scenes:Clean">
        <MSBuild Projects="01-Scenes\scenes.dproj" Targets="Clean"/>
    </Target>
    <Target Name="scenes:Make">
        <MSBuild Projects="01-Scenes\scenes.dproj" Targets="Make"/>
    </Target>
    <Target Name="Simple3D">
        <MSBuild Projects="Simple3D\Simple3D.dproj"/>
    </Target>
    <Target Name="Simple3D:Clean">
        <MSBuild Projects="Simple3D\Simple3D.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Simple3D:Make">
        <MSBuild Projects="Simple3D\Simple3D.dproj" Targets="Make"/>
