// Engine5 Upgrade Config
// Run: upgrade5 [--dry-run] [--verbose] file.pas

// === Remove old units from uses ===
-uses Apus.Common
-uses Apus.CrossPlatform

// === Type renames ===
TMyCriticalSection -> TLock [Apus.Threads]
PCriticalSection -> PLock [Apus.Threads]
StringArr -> Strings8 [Apus.Core]
StringArray8 -> Strings8 [Apus.Core]
AStringArr -> Strings8 [Apus.Core]
AStrings8 -> Strings8 [Apus.Core]
WStringArr -> Strings16 [Apus.Core]

// === Apus.Types ===
TBuffer -> TBuffer [Apus.Types]

// === Apus.Core: math ===
// Order matters: specific variants before generic
min2d -> Min [Apus.Core]
max2d -> Max [Apus.Core]
min2s -> Min [Apus.Core]
max2s -> Max [Apus.Core]
min2 -> Min [Apus.Core]
max2 -> Max [Apus.Core]
PointerInRange -> PtrInside [Apus.Core]
LinearMix -> Lerp [Apus.Core]

FillDword -> Mem.FillD [Apus.Core]
FillChar -> Mem.Fill [Apus.Core]

// === Apus.Core: bits ===
HasFlag -> Bits.HasAll [Apus.Core]
SetFlag -> Bits.SetFlag [Apus.Core]
GetBit -> Bits.Get [Apus.Core]
SetBit -> Bits.SetBit [Apus.Core]
GetBits -> Bits.GetBits [Apus.Core]
SetBits -> Bits.SetBits [Apus.Core]
ZeroMem -> Mem.Clear [Apus.Core]

// === Apus.Core: time ===
MyTickCount -> CoreTime.Ticks [Apus.Core]
NowGMT -> Time.UTC [Apus.Core]
Sleep() -> Time.Sleep [Apus.Core]

// === Apus.Conv: parsing and formatting ===
// Order matters: FormatHex before any shorter match
FormatHex -> Conv.ToHex [Apus.Conv]
PtrToStr -> Conv.ToStr [Apus.Conv]
BoolToAStr -> Conv.ToStr [Apus.Conv]
ParseInt -> Conv.ToInt [Apus.Conv]
ParseFloat -> Conv.ToFloat [Apus.Conv]
ParseBool -> Conv.ToBool [Apus.Conv]
HexToInt -> Conv.HexToInt [Apus.Conv]
SizeToStr -> Conv.FormatSize [Apus.Conv]
StrToIp -> Conv.ToIp [Apus.Conv]
IpToStr -> Conv.ToIp [Apus.Conv]
EncodeHex -> Conv.EncodeHex [Apus.Conv]
DecodeHex -> Conv.DecodeHex [Apus.Conv]
EncodeB64 -> Conv.ToBase64 [Apus.Conv]
DecodeB64 -> Conv.FromBase64 [Apus.Conv]
HexDump -> Conv.HexDump [Apus.Conv]
DecDump -> Conv.DecDump [Apus.Conv]
FormatTime -> Conv.TimeToStr [Apus.Conv]
FormatInt -> Conv.FormatInt [Apus.Conv]
FormatMoney -> Conv.FormatMoney [Apus.Conv]

// === Apus.Log: logging ===
// Order matters: ForceLogMessage before ForceLog before LogMessage
ForceLogMessage -> Log.Force [Apus.Log]
ForceLog -> Log.Force [Apus.Log]
LogMessage -> Log.Msg [Apus.Log]
LogError -> Log.Error [Apus.Log]
DebugMessage -> Log.Force [Apus.Log]
UseLogFile -> Logger.UseLogFile [Apus.Log]
FlushLog -> Logger.Flush [Apus.Log]
StopLogThread -> Logger.StopLogThread [Apus.Log]

// === Apus.Strings: string helpers ===
// Order matters: longer names first
Join -> String8.Join [Apus.Strings]

// === Apus.Utils: string/date utilities ===
// Same names, just need unit added to uses
Chop -> Chop [Apus.Utils]
SplitA -> SplitA [Apus.Utils]
GetDateFromStr -> GetDateFromStr [Apus.Utils]
ParseDate -> ParseDate [Apus.Utils]
ParseTime -> ParseTime [Apus.Utils]

// === Apus.Files: file I/O ===
LoadFileAsBytes -> Files.LoadAsBytes [Apus.Files]
LoadFileAsString -> Files.LoadAsString [Apus.Files]
MyFileExists -> Files.Exists [Apus.Files]
SafeFileName -> Files.SafeName [Apus.Files]
FileName() -> Files.FixName [Apus.Files]

// === Apus.Files: directories ===
ListFiles -> Folder.ListFiles [Apus.Files]
CopyDir -> Folder.Copy [Apus.Files]
MoveDir -> Folder.Move [Apus.Files]
DeleteDir -> Folder.Delete [Apus.Files]
FindFile -> Folder.Find [Apus.Files]

// === Apus.Threads ===
RegisterThread -> Thread.Register [Apus.Threads]
UnregisterThread -> Thread.Unregister [Apus.Threads]
PingThread -> Thread.Ping [Apus.Threads]
GetThreadName -> Thread.GetName [Apus.Threads]

// === Apus.Core: system messages ===
ErrorMessage -> SystemMessage [Apus.Core]

// === UI style keys (string literals — not rewritable here, see Base/engine5_changes.md 2026-09-02) ===
// button: color->fill (box), text-color->color (caption); checkbox: col->border-color, tick-col->tick-color
// frame: color->border-color, color-dark->border-dark; image: color->tint; window: color/col->fill
// editbox: col->color; scrollbar: col->color, track-col->track-color, active-col->active-color, style->variant
// any: border->border-color, inner-border->inner-border-color, hoverTime*->hover-time[-in|-out], hover->hover-target
SetStyle( -> ?use element.style.SetAttr(key,value) [Apus.Engine.UITypes]
// === UI style states (2026-09-05): drawers must resolve states through refs+tokens ===
style.GetStateColor( -> ?use element.GetStateStyleColor(state,key,def) [Apus.Engine.UITypes]
style.GetStateNumber( -> ?use element.GetStateStyleNumber(state,key,def) [Apus.Engine.UITypes]

// === UI skins (2026-09-05): image-per-state is a style value, not a field ===
// wnd.background:=tex  => wnd.style.SetAttr('background-image','tex:'+tex.name)  (or SetupSkinnedWindow(wnd,tex))
// SetupWindow(wnd,tiledImage) removed (never drawn); use SetupSkinnedWindow with a TTexture
// CustomStyle keys: image->background-image, image-color->background-tint, offset-x/y->background-offset-x/y
.background:= -> ?TUIWindow.background removed: style 'background-image' [Apus.Engine.UIWidgets]

// === TODO markers: need manual rewrite (call style changes) ===
InitCritSect -> ?use lock.Init(name[,level]) [Apus.Threads]
DeleteCritSect -> ?use lock.Cleanup [Apus.Threads]
SameText8 -> ?use a.Same(b) [Apus.Strings]
PosFrom -> ?manual rewrite: use st.IndexOf(substr[,startPos]); if old call had ignoreCase=true, use st.IndexOf(substr,startPos,true) [Apus.Strings]
LastPos -> ?use st.LastIndexOf(substr) [Apus.Strings]
ExtractStr -> ?use st.Extract(prefix,suffix) [Apus.Strings]
QuoteStr -> ?use st.Quote [Apus.Strings]
UnquoteStr -> ?use st.Unquote [Apus.Strings]
// Order: URLEncodeUTF8 before UrlEncode
URLEncodeUTF8 -> ?use st.UrlEncode [Apus.Strings]
UrlEncode() -> ?use st.UrlEncode [Apus.Strings]
Split() -> ?use st.Split(char) [Apus.Strings]
UpperCase() -> ?use st.ToUpper [Apus.Strings]
LowerCase() -> ?use st.ToLower [Apus.Strings]
TrimLeft() -> ?use st.TrimLeft [Apus.Strings]
TrimRight() -> ?use st.TrimRight [Apus.Strings]
GetUTCTime() -> ?use Time.Stamp [Apus.Core]
EncodeUTF8() -> ?use UTF8.Encode (check arg types) [Apus.Strings]
DecodeUTF8() -> ?use UTF8.Decode (check arg types) [Apus.Strings]
SaveFile -> ?use Files.Save(fname,data) [Apus.Files]
Files.Open -> ?manual rewrite: Files.Open(f,true) is Files.OpenRead(f); Files.Open(f,false) is Files.Open(f) to keep the content, or Files.OpenNew(f) to replace it [Apus.Files]
FindDir -> ?use Folder.Find(name,path,true) [Apus.Files]
EnterCriticalSection -> ?use TLock.Enter [Apus.Threads]
LeaveCriticalSection -> ?use TLock.Leave [Apus.Threads]
HasPrefix -> ?use .StartsWith [Apus.Strings]

// === Apus.Geom2D / Apus.Geom3D: type renames ===
// Order: longer/more specific names first
// 2D types
TRect2s -> TRect2 [Apus.Geom2D]
TMatrix32s -> TMat32 [Apus.Geom2D]
TVector2s -> TVec2 [Apus.Geom2D]
TPoint2s -> TVec2 [Apus.Geom2D]
PPoint2s -> PVec2 [Apus.Geom2D]
TPoint2 -> TVec2d [Apus.Geom2D]
// 3D types
TMatrix4s -> TMat4 [Apus.Geom3D]
TMatrix43s -> TMat43 [Apus.Geom3D]
TMatrix4 -> TMat4d [Apus.Geom3D]
T3DMatrixS -> TMat4 [Apus.Geom3D]
T3DMatrix -> TMat4d [Apus.Geom3D]
T2DMatrix -> TMat32 [Apus.Geom2D]
TQuaternionS -> TQuat [Apus.Geom3D]
TQuaternion -> TQuatd [Apus.Geom3D]
TVector4s -> TQuat [Apus.Geom3D]
TVector3s -> TVec3 [Apus.Geom3D]
PPoint3s -> PVec3 [Apus.Geom3D]
TPoint3s -> TVec3 [Apus.Geom3D]
TPoint3 -> TVec3d [Apus.Geom3D]

// === Apus.Geom2D: constant renames ===
IdentMatrix32 -> IdentMat32d [Apus.Geom2D]
IdentMatrix2 -> IdentMat2d [Apus.Geom2D]

// === Apus.Geom3D: constant renames ===
IdentMatrix4s -> IdentMat4 [Apus.Geom3D]
IdentMatrix4 -> IdentMat4d [Apus.Geom3D]
IdentMatrix3s -> IdentMat3 [Apus.Geom3D]
IdentMatrix3 -> IdentMat3d [Apus.Geom3D]

// === Apus.Geom3D: deprecated matrix factory functions (auto-replaceable) ===
TranslationMat4d -> TMat4d.Translation [Apus.Geom3D]
TranslationMat4 -> TMat4.Translation [Apus.Geom3D]
TranslationMat -> TMat34d.Translation [Apus.Geom3D]
RotationMat4X -> TMat4.RotationX [Apus.Geom3D]
RotationMat4Y -> TMat4.RotationY [Apus.Geom3D]
RotationMat4Z -> TMat4.RotationZ [Apus.Geom3D]
RotationXMat -> TMat34d.RotationX [Apus.Geom3D]
RotationYMat -> TMat34d.RotationY [Apus.Geom3D]
RotationZMat -> TMat34d.RotationZ [Apus.Geom3D]
ScaleMat4 -> TMat4.Scale [Apus.Geom3D]
ScaleMat -> TMat34d.Scale [Apus.Geom3D]

PRect2s -> PRect2

// === Apus.Geom3D: vector factory functions ===
// Order: Vector3s before Vec3s (avoid partial match)
QuaternionS -> Quat [Apus.Geom3D]
Vector4s -> Vec4 [Apus.Geom3D]
Point3s -> Vec3 [Apus.Geom3D]
Vec3s -> Vec3 [Apus.Geom3D]
// Note: Vector3s(p0,p1) form (direction from p0 to p1) requires manual rewrite → p1.Sub(p0)
Vector3s -> Vec3 [Apus.Geom3D]
Point2s -> Vec2 [Apus.Geom2D]

// === Manual rewrites (context-dependent, auto-replace not possible) ===
// DotProduct(a,b) → a.Dot(b)
// CrossProduct(a,b) → a.Cross(b)
// VectAdd(a,b) → a.Add(b)    [mutating Add now on TVec2/TVec3/TVec2d]
// VectMult(a,k) → a.Multiply(k)  [mutating Multiply now on TVec2/TVec3/TVec2d]
// VectSub(a,b) → a:=a.Sub(b)  [Sub is functional, no mutating version]
// PointAdd(p,v,f) → p.Add(v); p.Multiply(f) OR manual  [adds v*f to p]
// MultPnt(m,v,n,step) → m.TransformPoints(v,n,step)
// MultMat(m1,m2,out) → out:=m1*m2
// MatRow(m,n) → m.Row(n)
// MatCol(m,n) → m.Col(n)
// Vector3s(p0,p1) → p1.Sub(p0)  [2-arg form: direction vector from p0 to p1]
// YRPToMatrix(mat,...) → use deprecated wrapper or rewrite with TMat34d.FromYRP

// === Apus.Compress: compression and patching ===
PackRLE -> RLE.Pack [Apus.Compress]
UnpackRLE -> RLE.Unpack [Apus.Compress]
CheckRLEHeader -> RLE.CheckHeader [Apus.Compress]
SimpleCompress -> LZ.Compress [Apus.Compress]
SimpleDecompress -> LZ.Decompress [Apus.Compress]
CreateBackupPatch -> Patch.Create [Apus.Compress]
ApplyBackupPatch -> Patch.Apply [Apus.Compress]

// === Apus.Colors: color API renames ===
// Note: local vars named 'color' must be renamed to 'col' to avoid shadowing the Color type
MyColor -> Color.RGB [Apus.Colors]     // 3-arg form; 4-arg MyColor(a,r,g,b) → Color.ARGB
MyColorF -> Color.ARGBf [Apus.Colors]
GrayColor -> Color.Gray [Apus.Colors]
GrayAlpha -> Color.GrayAlpha [Apus.Colors]
SwapColor -> Color.Swap [Apus.Colors]
GetAlpha -> Color.Alpha [Apus.Colors]
IsSemiTransparent -> Color.HasAlpha [Apus.Colors]
ColorAdd -> Color.Add [Apus.Colors]
ColorSub -> Color.Sub [Apus.Colors]
ColorMult2 -> Color.Mult [Apus.Colors]
ColorAlpha -> Color.Scale [Apus.Colors]
ReplaceAlpha -> Color.SetAlpha [Apus.Colors]
ColorMix -> Color.Mix [Apus.Colors]    // int overload; ColorMixF → Color.Mix (float)
ColorMixF -> Color.Mix [Apus.Colors]
ColorBlend -> Color.Blend [Apus.Colors] // int overload; ColorBlendF → Color.Blend (float)
ColorBlendF -> Color.Blend [Apus.Colors]
BilinearBlend -> Color.BilinearBlend [Apus.Colors]
BilinearMix -> Color.BilinearMix [Apus.Colors]  // 6-arg form; pointer overload stays free
Lightness -> Color.Lightness [Apus.Colors]
Brightness -> Color.Brighten [Apus.Colors]
Contrast -> Color.Contrast [Apus.Colors]
SimpleColorDiff -> Color.SimpleDiff [Apus.Colors]
ColorDiff -> Color.Diff [Apus.Colors]
// Blend(bg,fg) → Color.Blend(bg,fg)  [2-arg free function — manual, context-sensitive]

// === Apus.Engine.API: TCullMode scoped enum (semantics inverted: name now = faces DRAWN, not culled) ===
// Order matters: cullCCW before cullCW (substring); inversion: cullCW=>DrawCCW, cullCCW=>DrawCW
cullCCW -> TCullMode.DrawCW [Apus.Engine.API]
cullCW -> TCullMode.DrawCCW [Apus.Engine.API]
cullNone -> TCullMode.DrawAll [Apus.Engine.API]

// === Apus.Engine.API: depth state — UseDepthBuffer renamed to SetDepthMode, TDepthBufferTest -> TDepthTest (scoped) ===
// Order matters: longer dbPass* before dbPass (substring). Second arg writeEnable -> TDepthWrite is manual (see note).
UseDepthBuffer -> SetDepthMode [Apus.Engine.API]
dbPassLessEqual -> TDepthTest.LessEqual [Apus.Engine.API]
dbPassGreater -> TDepthTest.Greater [Apus.Engine.API]
dbPassLess -> TDepthTest.Less [Apus.Engine.API]
dbPass -> TDepthTest.Pass [Apus.Engine.API]
dbDisabled -> TDepthTest.Disabled [Apus.Engine.API]
dbNever -> TDepthTest.Never [Apus.Engine.API]
// SetDepthMode(test,false) → SetDepthMode(test,TDepthWrite.Off); ,true → ,TDepthWrite.On  [2nd arg type changed boolean→TDepthWrite — manual]

// === R-31 working surface model (Apus.Engine.Types / TWindow / TGameApplication) ===
// TWindow geometry fields became a resolved surface snapshot.
window.renderWidth -> window.canvasWidth [Apus.Engine.Window]
window.renderHeight -> window.canvasHeight [Apus.Engine.Window]
window.windowWidth -> window.clientWidth [Apus.Engine.Window]
window.windowHeight -> window.clientHeight [Apus.Engine.Window]
window.screenDPI -> window.surface.dpi [Apus.Engine.Window]
// Coordinate transforms became functions: ClientToGame(p) => p:=ClientToCanvas(p)  [manual]
// ClientToGame -> ClientToCanvas, GameToClient -> CanvasToClient; new TryClientToCanvas
// TGameSettings.mode/altMode are plain TDisplayMode now; the axes live in TGameSettings.surface.
// Order matters: altMode before mode (substring).
altMode.displayMode -> altMode [Apus.Engine.Types]
mode.displayMode -> mode [Apus.Engine.Types]
// Removed with no replacement (delete the line, then declare the surface with a preset):
//   mode.displayFitMode / mode.displayScaleMode, TDisplayFitMode (dfm*), TDisplayScaleMode (dsm*),
//   TDisplaySettings, TGameAppMode/gameMode, directRenderOnly, useRealDPI
// gamUseFullWindow    => SetupFullWindow (the default; nothing to write)
// gamKeepAspectRatio  => SetupFixedCanvas(w,h)
// TGame.SetupRenderArea / TGame.SizeChanged => wnd.RequestResize + wnd.ApplyPendingSurface
// Signal('ENGINE\RESIZE',...) => wnd.RequestResize(w,h)
// ENGINE\BEFORERESIZE, ENGINE\RESIZED, ENGINE\DPICHANGED[\DONE] => ENGINE\SURFACECHANGED (tag=wnd, after the rebuild)
game.RenderSize -> game.CanvasSize [Apus.Engine.API]
